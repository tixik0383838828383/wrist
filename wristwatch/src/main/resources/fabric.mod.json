{
	"schemaVersion": 1,
	"id": "wristwatch",
	"version": "${version}",
	"name": "WristWatch",
	"description": "Показывает хотбар в виде часов на руке; поднимай руку, чтобы посмотреть на него. Работает в мультиплеере у тех, кто установил мод.",
	"authors": [
		"Timur"
	],
	"contact": {},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.timur.wristwatch.WristWatchMod"
		],
		"client": [
			"com.timur.wristwatch.client.WristWatchClient"
		]
	},
	"mixins": [
		{
			"config": "wristwatch.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
